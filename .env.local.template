# Development Environment Variables Template
# Copy this file to .env.local and fill in your development API keys

# Elasticsearch Configuration (Development)
ELASTIC_URL=your-elasticsearch-url-here
ELASTIC_API_KEY=your-elasticsearch-api-key-here
ELASTIC_INDEX=scene_segments

# Gemini API Configuration (Development)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash-preview-05-20
EMBEDDING_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent

# LangCache Configuration (Development - Optional)
LANGCACHE_API_KEY=your-langcache-api-key-here
LANGCACHE_MODEL=langcache-embedding-model-v1

# Cloud Storage (Development)
CLOUD_STORAGE_BUCKET=your-cloud-storage-bucket-here

# Video Generation (Development - Optional)
VEO_API_KEY=your-veo-api-key-here
VEO_API_URL=https://aiplatform.googleapis.com/v1/projects/{project}/locations/{location}/publishers/google/models/veo-3-fast:generateVideo
VEO_LOCATION=us-central1