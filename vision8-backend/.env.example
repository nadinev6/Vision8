# Vision8 Environment Configuration

# Elasticsearch Configuration
ELASTIC_URL=https://my-elasticsearch-project-dc9e71.es.us-central1.gcp.elastic-cloud.com:443
ELASTIC_API_KEY=your_elastic_api_key_here
ELASTIC_INDEX=scene_segments

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Google Cloud Speech-to-Text Configuration
SPEECH_TO_TEXT_LANGUAGE=en-US
SPEECH_TO_TEXT_MODEL=latest_long
SPEECH_TO_TEXT_ENABLE_WORD_TIMESTAMPS=true
SPEECH_TO_TEXT_ENABLE_PUNCTUATION=true

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash-preview-05-20
EMBEDDING_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent

# Cloud Storage
CLOUD_STORAGE_BUCKET=your-vision8-storage-bucket

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG_MODE=false  # Set to true for development

# Security
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
MAX_REQUEST_SIZE=50MB
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
REDIS_URL=your_redis_url_if_needed
VECTOR_CACHE_SIZE=1000
VECTOR_CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Speech-to-Text Configuration (Optional - defaults provided)
SPEECH_TO_TEXT_LANGUAGE=en-US
SPEECH_TO_TEXT_MODEL=latest_long
SPEECH_TO_TEXT_ENABLE_WORD_TIMESTAMPS=true
SPEECH_TO_TEXT_ENABLE_PUNCTUATION=true
MAX_AUDIO_FILE_SIZE_MB=200
AUDIO_SAMPLE_RATE=16000

